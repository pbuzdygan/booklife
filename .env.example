# Used only with compose.ghcr.yaml. Default is ghcr.io/pbuzdygan/booklife:latest.
# For the dev channel use: ghcr.io/pbuzdygan/booklife:dev_latest
# BOOKLIFE_IMAGE=ghcr.io/pbuzdygan/booklife:latest

BOOKLIFE_DEBUG=false
# Generate once with: openssl rand -hex 32
BOOKLIFE_SECRET_KEY=paste-the-generated-64-character-value-here
BOOKLIFE_UID=1000
BOOKLIFE_GID=1000
#Specifies the IP address that the server should listen on. Change to 0.0.0.0 to listen on all available network interfaces.
BOOKLIFE_BIND_ADDRESS=127.0.0.1
BOOKLIFE_PORT=8019
#If using proxy add its name also
BOOKLIFE_ALLOWED_HOSTS=localhost,127.0.0.1
#Set trusted domains by http://IP:PORT and/or https://subdomain.example.com
BOOKLIFE_CSRF_TRUSTED_ORIGINS=
BOOKLIFE_TIME_ZONE=Europe/Warsaw

# Enable only when Booklife is behind a trusted reverse proxy that sets
# X-Forwarded-Proto. The safe default for direct access is false.
BOOKLIFE_TRUST_PROXY_HEADERS=false

# Keep these false while local HTTP is required. Enable them only for an
# HTTPS-only installation; direct HTTP access will then stop working.
BOOKLIFE_SECURE_COOKIES=false
BOOKLIFE_SECURE_SSL_REDIRECT=false
BOOKLIFE_HSTS_SECONDS=0
